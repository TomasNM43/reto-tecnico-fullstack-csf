{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "CAMBIAR-ESTA-CLAVE-EN-PRODUCCION-clinica-san-felipe-2026",
    "Issuer": "ClinicaSanFelipe",
    "Audience": "ClinicaSanFelipe.Clients",
    "ExpirationMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/api/auth/login" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "productos": {
        "ClusterId": "productos",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/productos/{**resto}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "kardex": {
        "ClusterId": "movimientos",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/kardex/{**resto}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "compras": {
        "ClusterId": "compras",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/compras/{**resto}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "ventas": {
        "ClusterId": "ventas",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/ventas/{**resto}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "productos": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "movimientos": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } },
      "compras": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } },
      "ventas": { "Destinations": { "d1": { "Address": "http://localhost:5105" } } }
    }
  }
}
