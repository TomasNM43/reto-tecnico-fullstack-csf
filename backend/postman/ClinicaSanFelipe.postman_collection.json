    {
      "name": "5. Seguridad",
      "item": [
        {
          "name": "Health del gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway arriba (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('No expone la cabecera Server', function () { pm.expect(pm.response.headers.has('Server')).to.be.false; });",
                  "pm.test('Trae cabeceras de seguridad', function () {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [ "{{baseUrl}}" ],
              "path": [ "health" ]
            }
          }
        },
        {
          "name": "Listar Productos sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin token no entra (401)', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "productos" ]
            }
          }
        },
        {
          "name": "Listar Productos con token inválido (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token inválido (401)', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "token.invalido.xyz", "type": "string" } ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "productos" ]
            }
          }
        },
        {
          "name": "Movimientos no se expone por el gateway (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El endpoint interno no está publicado (404)', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/api/movimientos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "movimientos" ]
            }
          }
        }
