              "path": [ "api", "kardex" ]
            },
            "description": "Un renglón por producto con su stock actual."
          }
        },
        {
          "name": "Movimientos de un producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kardex/{{idProducto}}/movimientos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "kardex", "{{idProducto}}", "movimientos" ]
            },
            "description": "Fecha, tipo de movimiento y cantidad (lo que muestra el modal de cada fila del Kardex)."
          }
        },
        {
          "name": "Stock de un producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve un número', function () { pm.expect(pm.response.json()).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kardex/{{idProducto}}/stock",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "kardex", "{{idProducto}}", "stock" ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Compras",
      "item": [
        {
          "name": "Registrar Compra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Compra creada (201)', function () { pm.response.to.have.status(201); });",
                  "pm.test('Los importes cuadran (IGV sobre el subtotal)', function () {",
                  "    const compra = pm.response.json();",
                  "    pm.expect(compra.subTotal).to.eql(200);",
                  "    pm.expect(compra.igv).to.eql(36);",
                  "    pm.expect(compra.total).to.eql(236);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detalles\": [\n    { \"idProducto\": {{idProducto}}, \"cantidad\": 10, \"precio\": 20.00 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/compras",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "compras" ]
            },
            "description": "Varios productos por compra: agrega más objetos al arreglo `detalles`."
          }
        },
        {
          "name": "Listar Compras",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/compras",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "compras" ]
            }
          }
        },
        {
          "name": "Registrar Compra inválida (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validación fallida (400)', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"detalles\": []\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/compras",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "compras" ]
            }
          }
        }
