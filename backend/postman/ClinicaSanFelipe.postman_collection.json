{
  "info": {
    "name": "Clínica San Felipe - API",
    "description": "Colección de pruebas del reto técnico. Todas las peticiones pasan por el API Gateway ({{baseUrl}}).\n\nOrden sugerido: 1) Auth > Login (guarda el token), 2) el resto de carpetas en secuencia: la compra deja stock del producto y la venta lo usa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Guarda el JWT en el environment para que lo usen las demás peticiones.",
                  "if (pm.response.code === 200) {",
                  "    const datos = pm.response.json();",
                  "    pm.environment.set('token', datos.token);",
                  "    pm.test('El token se guardó en el environment', function () {",
                  "        pm.expect(pm.environment.get('token')).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            },
            "description": "Devuelve un JWT válido por 30 minutos. El script de test lo guarda en la variable de entorno `token`."
          }
        },
        {
          "name": "Login con clave incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales inválidas (401)', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"clave-incorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            },
            "description": "El login tiene un límite de 5 intentos por minuto; si lo superas responde 429."
          }
        }
      ]
    },
    {
      "name": "1. Productos",
      "item": [
        {
          "name": "Listar Productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "productos" ]
            }
          }
        },
        {
          "name": "Registrar Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Producto creado (201)', function () { pm.response.to.have.status(201); });",
                  "",
                  "// Guarda el id para usarlo en Actualizar, Compra y Venta.",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('idProducto', pm.response.json().idProducto);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreProducto\": \"Mascarilla N95\",\n  \"nroLote\": \"L2026-100\",\n  \"costo\": 2.50,\n  \"precioVenta\": 3.38\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "productos" ]
            }
          }
        },
        {
          "name": "Actualizar Producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Se actualizó el nombre', function () { pm.expect(pm.response.json().nombreProducto).to.eql('Mascarilla N95 (x2)'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreProducto\": \"Mascarilla N95 (x2)\",\n  \"nroLote\": \"L2026-100\",\n  \"costo\": 3.00,\n  \"precioVenta\": 4.05\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{idProducto}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "productos", "{{idProducto}}" ]
            }
          }
        },
        {
          "name": "Registrar Producto inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Validación fallida (400)', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreProducto\": \"\",\n  \"nroLote\": \"\",\n  \"costo\": -1,\n  \"precioVenta\": -1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "productos" ]
            }
          }
        }
      ]
    },
